NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://sweets:sweets@localhost:5432/sweets?schema=public
REDIS_URL=redis://localhost:6379

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30

# Comma-separated list of allowed browser origins (storefront + ERP)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

CURRENCY=INR
# Flat delivery fee and the order subtotal above which delivery is free
DELIVERY_FEE=49
FREE_DELIVERY_ABOVE=999

# Seeded admin account
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!

# Refresh storefront catalog pages immediately after ERP edits (must match the web app's secret)
STOREFRONT_REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=change-me-shared-revalidate-secret

# Seller details on GST invoices (placeholders: replace with the registered business details)
SELLER_LEGAL_NAME="Mithai House Foods Pvt. Ltd. (placeholder)"
SELLER_TRADE_NAME="Mithai House"
SELLER_GSTIN=27AAAAA0000A1Z5
SELLER_ADDRESS="Shop No. 1, Main Road, Thane West, Maharashtra 400601"
SELLER_STATE=Maharashtra
SELLER_STATE_CODE=27
SELLER_FSSAI=XXXXXXXXXXXXXX
SELLER_PHONE="+91 98765 43210"
SELLER_EMAIL=hello@example.com
INVOICE_PREFIX=MH
