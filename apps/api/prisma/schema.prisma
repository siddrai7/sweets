// Sweets platform — single source of truth for all data.
// Enums here must stay in sync with packages/types/src/enums.ts.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Identity ─────────────────────────────

enum Role {
  ADMIN
  STAFF
  VENDOR
  CUSTOMER
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  phone        String?   @unique
  name         String
  passwordHash String
  role         Role      @default(CUSTOMER)
  isActive     Boolean   @default(true)
  /// Created by guest checkout: no usable password, orders reached by a private link.
  isGuest      Boolean   @default(false)
  /// Set only for VENDOR users — the supplier they log in on behalf of.
  vendorId     String?
  vendor       Vendor?   @relation(fields: [vendorId], references: [id])
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  refreshTokens   RefreshToken[]
  addresses       Address[]
  orders          Order[]
  statusChanges   OrderStatusEvent[]
  stockMovements  StockMovement[]
  cartItems       CartItem[]
  returnsCreated  ReturnRequest[]    @relation("ReturnCreatedBy")
  returnsResolved ReturnRequest[]    @relation("ReturnResolvedBy")
  reviews         Review[]
  wishlist        WishlistItem[]

  @@index([role])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 of the token; the raw token is never stored.
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String?
  name      String
  phone     String
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// A signed-in customer's cart, so it follows them across devices. Prices are never stored
/// here: the cart is always shown with current catalog prices and stock.
model CartItem {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([userId, variantId])
}

// ───────────────────────────── Catalog ─────────────────────────────

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  imageUrl    String?
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  products Product[]
}

model Product {
  id                  String   @id @default(cuid())
  name                String
  slug                String   @unique
  description         String?
  categoryId          String
  category            Category @relation(fields: [categoryId], references: [id])
  images              String[]
  tags                String[]
  /// Other names customers search for, e.g. "laddu", "burfi". Matched by storefront search.
  searchAliases       String[] @default([])
  isVeg               Boolean  @default(true)
  isActive            Boolean  @default(true)
  isFeatured          Boolean  @default(false)
  /// Used to default a batch's expiry date when it is produced.
  shelfLifeDays       Int?
  hsnCode             String?
  taxRatePercent      Decimal  @default(5) @db.Decimal(5, 2)
  metaTitle           String?
  metaDescription     String?
  /// Shown on the product page; free text so the kitchen can write it naturally.
  ingredients         String?
  allergens           String?
  storageInstructions String?
  /// Lowest active variant price, kept in sync by CatalogService so lists can sort/filter by price.
  basePrice           Decimal? @db.Decimal(10, 2)
  /// Average of approved reviews, kept in sync by ReviewsService.
  ratingAvg           Decimal? @db.Decimal(3, 2)
  ratingCount         Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  variants ProductVariant[]
  reviews  Review[]
  wishedBy WishlistItem[]

  @@index([categoryId])
  @@index([isActive, isFeatured])
  @@index([basePrice])
}

/// A sellable unit of a product: "250 g", "1 kg", "Box of 12".
model ProductVariant {
  id                String   @id @default(cuid())
  productId         String
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku               String   @unique
  label             String
  weightGrams       Int?
  price             Decimal  @db.Decimal(10, 2)
  mrp               Decimal? @db.Decimal(10, 2)
  isActive          Boolean  @default(true)
  sortOrder         Int      @default(0)
  /// Alert in the ERP when sellable stock drops to or below this.
  lowStockThreshold Int      @default(5)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  batches        StockBatch[]
  stockMovements StockMovement[]
  orderItems     OrderItem[]
  recipe         RecipeItem[]
  cartItems      CartItem[]
  stockAlerts    StockAlert[]

  @@index([productId])
}

// ───────────────────────────── Inventory ─────────────────────────────

enum LocationType {
  KITCHEN
  STORE
  WAREHOUSE
}

model Location {
  id        String       @id @default(cuid())
  name      String
  type      LocationType
  address   String?
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  batches        StockBatch[]
  stockMovements StockMovement[]
}

/// Finished-goods stock is tracked per batch so we can sell oldest-first and
/// flag anything close to expiry. `quantity` is the units remaining.
model StockBatch {
  id              String         @id @default(cuid())
  variantId       String
  variant         ProductVariant @relation(fields: [variantId], references: [id])
  locationId      String
  location        Location       @relation(fields: [locationId], references: [id])
  batchCode       String
  quantity        Int
  initialQuantity Int
  producedAt      DateTime       @default(now())
  expiresAt       DateTime?
  unitCost        Decimal?       @db.Decimal(10, 2)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  movements StockMovement[]

  @@index([variantId, expiresAt])
  @@index([locationId])
}

enum StockMovementType {
  PRODUCTION
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
  WASTAGE
  TRANSFER
}

/// Append-only ledger of every stock change. Batch quantities are the running
/// result of these rows; never edit a batch quantity without writing a movement.
model StockMovement {
  id            String            @id @default(cuid())
  type          StockMovementType
  variantId     String
  variant       ProductVariant    @relation(fields: [variantId], references: [id])
  batchId       String?
  batch         StockBatch?       @relation(fields: [batchId], references: [id])
  locationId    String
  location      Location          @relation(fields: [locationId], references: [id])
  /// Signed: positive adds stock, negative removes it.
  quantity      Int
  referenceType String?
  referenceId   String?
  note          String?
  createdById   String?
  createdBy     User?             @relation(fields: [createdById], references: [id])
  createdAt     DateTime          @default(now())

  @@index([variantId, createdAt])
  @@index([referenceType, referenceId])
}

enum MeasurementUnit {
  KG
  G
  L
  ML
  PCS
}

model RawMaterial {
  id           String          @id @default(cuid())
  name         String          @unique
  unit         MeasurementUnit
  reorderLevel Decimal         @default(0) @db.Decimal(12, 3)
  currentStock Decimal         @default(0) @db.Decimal(12, 3)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  recipeItems        RecipeItem[]
  purchaseOrderItems PurchaseOrderItem[]
}

/// Bill of materials: raw materials consumed to produce ONE unit of a variant.
model RecipeItem {
  id            String         @id @default(cuid())
  variantId     String
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  rawMaterialId String
  rawMaterial   RawMaterial    @relation(fields: [rawMaterialId], references: [id])
  quantity      Decimal        @db.Decimal(12, 3)

  @@unique([variantId, rawMaterialId])
}

// ───────────────────────────── Vendors & purchasing ─────────────────────────────

model Vendor {
  id          String   @id @default(cuid())
  name        String
  contactName String?
  email       String?
  phone       String?
  gstin       String?
  address     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users          User[]
  purchaseOrders PurchaseOrder[]
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  ACKNOWLEDGED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id         String              @id @default(cuid())
  poNumber   String              @unique
  vendorId   String
  vendor     Vendor              @relation(fields: [vendorId], references: [id])
  status     PurchaseOrderStatus @default(DRAFT)
  expectedAt DateTime?
  notes      String?
  total      Decimal             @db.Decimal(12, 2)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  items PurchaseOrderItem[]

  @@index([vendorId, status])
}

model PurchaseOrderItem {
  id              String          @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder   @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  rawMaterialId   String?
  rawMaterial     RawMaterial?    @relation(fields: [rawMaterialId], references: [id])
  description     String
  quantity        Decimal         @db.Decimal(12, 3)
  unit            MeasurementUnit
  unitPrice       Decimal         @db.Decimal(10, 2)
  lineTotal       Decimal         @db.Decimal(12, 2)
}

// ───────────────────────────── Orders & payments ─────────────────────────────

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
}

enum FulfillmentType {
  DELIVERY
  PICKUP
}

enum OrderChannel {
  WEB
  APP
  POS
  ERP
}

model Order {
  id                String          @id @default(cuid())
  orderNumber       String          @unique
  customerId        String
  customer          User            @relation(fields: [customerId], references: [id])
  status            OrderStatus     @default(PENDING_PAYMENT)
  fulfillment       FulfillmentType @default(DELIVERY)
  channel           OrderChannel    @default(WEB)
  /// Snapshot of the delivery address at the time of ordering.
  address           Json?
  deliverySlotStart DateTime?
  deliverySlotEnd   DateTime?
  subtotal          Decimal         @db.Decimal(12, 2)
  taxTotal          Decimal         @db.Decimal(12, 2)
  deliveryFee       Decimal         @default(0) @db.Decimal(10, 2)
  discountTotal     Decimal         @default(0) @db.Decimal(10, 2)
  total             Decimal         @db.Decimal(12, 2)
  notes             String?
  /// SHA-256 of the private link token for guest orders (raw token is never stored).
  guestTokenHash    String?         @unique
  /// Coupon applied at checkout (code copied so the order reads right if the coupon changes).
  couponId          String?
  coupon            Coupon?         @relation(fields: [couponId], references: [id])
  couponCode        String?
  /// Gift orders: a card message, gift wrap, and an invoice-free packing slip.
  isGift            Boolean         @default(false)
  giftMessage       String?
  giftWrap          Boolean         @default(false)
  /// GST tax invoice, issued when the order is delivered (or collected). Sequential per
  /// financial year, e.g. "MH/26-27/00042".
  invoiceNumber     String?         @unique
  invoicedAt        DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  items         OrderItem[]
  payments      Payment[]
  statusHistory OrderStatusEvent[]
  returns       ReturnRequest[]

  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@index([couponId])
}

/// Product name, label and price are copied at order time so later catalog
/// edits never change historical orders or invoices.
model OrderItem {
  id             String         @id @default(cuid())
  orderId        String
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId      String
  variant        ProductVariant @relation(fields: [variantId], references: [id])
  productName    String
  variantLabel   String
  sku            String
  unitPrice      Decimal        @db.Decimal(10, 2)
  quantity       Int
  /// This line's share of the order's coupon discount (tax-inclusive), for the GST invoice.
  discount       Decimal        @default(0) @db.Decimal(10, 2)
  taxRatePercent Decimal        @db.Decimal(5, 2)
  /// HSN code at the time of ordering, for the GST invoice.
  hsnCode        String?
  lineTotal      Decimal        @db.Decimal(12, 2)

  @@index([orderId])
}

model OrderStatusEvent {
  id          String      @id @default(cuid())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      OrderStatus
  note        String?
  changedById String?
  changedBy   User?       @relation(fields: [changedById], references: [id])
  createdAt   DateTime    @default(now())

  @@index([orderId])
}

enum PaymentProvider {
  COD
  RAZORPAY
  STRIPE
  MANUAL
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Payment {
  id          String          @id @default(cuid())
  orderId     String
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider    PaymentProvider
  status      PaymentStatus   @default(PENDING)
  amount      Decimal         @db.Decimal(12, 2)
  /// Gateway order / payment id, used to reconcile webhooks.
  providerRef String?         @unique
  raw         Json?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([orderId])
}

/// Last invoice number issued per financial year ("26-27"). Incremented in the same
/// transaction that issues the invoice, so numbers are gapless and never reused.
model InvoiceSequence {
  financialYear String @id
  lastNumber    Int    @default(0)
}

// ───────────────────────────── Returns & refunds ─────────────────────────────

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
}

enum ReturnReason {
  DAMAGED
  WRONG_ITEM
  MISSING_ITEM
  QUALITY
  OTHER
}

enum RefundMethod {
  CASH
  UPI
  BANK_TRANSFER
  ORIGINAL_PAYMENT
}

/// A customer's "report a problem" on a delivered order, or a refund staff recorded
/// directly. Sweets are perishable, so nothing is restocked; approval records the refund.
model ReturnRequest {
  id              String        @id @default(cuid())
  orderId         String
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status          ReturnStatus  @default(REQUESTED)
  reason          ReturnReason
  /// [{ orderItemId, quantity }] the customer is unhappy with.
  items           Json
  note            String?
  /// Value of the affected items, as the customer asked.
  requestedAmount Decimal       @db.Decimal(12, 2)
  refundAmount    Decimal?      @db.Decimal(12, 2)
  refundMethod    RefundMethod?
  /// Shown to the customer: why it was rejected, or how the refund was paid.
  resolutionNote  String?
  createdById     String
  createdBy       User          @relation("ReturnCreatedBy", fields: [createdById], references: [id])
  resolvedById    String?
  resolvedBy      User?         @relation("ReturnResolvedBy", fields: [resolvedById], references: [id])
  resolvedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([orderId])
  @@index([status, createdAt])
}

// ───────────────────────────── Delivery & search ─────────────────────────────

/// Pincodes the shop delivers to. While this table is empty, every pincode is accepted.
model ServiceArea {
  id        String   @id @default(cuid())
  pincode   String   @unique
  /// e.g. "Thane West", shown to the customer.
  label     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Small key/value settings edited in the ERP, e.g. delivery slots and closures.
model StoreSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// What customers search for, for the ERP's search report.
model SearchTerm {
  term           String   @id
  searches       Int      @default(0)
  zeroResults    Int      @default(0)
  lastResults    Int      @default(0)
  lastSearchedAt DateTime @default(now())

  @@index([zeroResults])
  @@index([searches])
}

// ───────────────────────────── Website engagement ─────────────────────────────

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())
}

model ContactMessage {
  id        String    @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  handledAt DateTime?
  createdAt DateTime  @default(now())

  @@index([handledAt, createdAt])
}

enum CouponType {
  PERCENT
  FLAT
  FREE_DELIVERY
}

/// Discount codes, managed in the ERP. Discounts come off tax-inclusive prices, so each order
/// line's taxable value shrinks in proportion (see OrderItem.discount).
model Coupon {
  id               String     @id @default(cuid())
  /// Upper-case, e.g. "DIWALI10".
  code             String     @unique
  description      String?
  type             CouponType
  /// Percent (1-100) or rupees off; ignored for FREE_DELIVERY.
  value            Decimal    @default(0) @db.Decimal(10, 2)
  /// Cap on a percentage discount, in rupees.
  maxDiscount      Decimal?   @db.Decimal(10, 2)
  minSubtotal      Decimal    @default(0) @db.Decimal(10, 2)
  startsAt         DateTime?
  endsAt           DateTime?
  /// Total redemptions allowed; null = unlimited.
  usageLimit       Int?
  perCustomerLimit Int?       @default(1)
  firstOrderOnly   Boolean    @default(false)
  isActive         Boolean    @default(true)
  /// Redemptions on orders that weren't cancelled.
  usedCount        Int        @default(0)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  orders Order[]
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Product reviews from customers who received the product. Shown once approved in the ERP.
model Review {
  id             String       @id @default(cuid())
  productId      String
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId        String?
  rating         Int
  title          String?
  body           String?
  status         ReviewStatus @default(PENDING)
  /// Staff note shown to nobody but staff, e.g. why it was rejected.
  moderationNote String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([productId, userId])
  @@index([status, createdAt])
  @@index([productId, status])
}

model WishlistItem {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, productId])
}

/// "Notify me when back in stock" requests. Emailed (and cleared) when the size is restocked.
model StockAlert {
  id         String         @id @default(cuid())
  variantId  String
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  email      String
  createdAt  DateTime       @default(now())
  notifiedAt DateTime?

  @@unique([variantId, email])
  @@index([notifiedAt])
}
